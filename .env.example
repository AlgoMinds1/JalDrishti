# ─────────────────────────────────────────────
#  JalDrishti — Environment Variables Template
#  Copy this to .env and fill in real values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────

# ── Database (Neon — no local Postgres needed) ──
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/jaldrishti?sslmode=require

# ── Groq (Primary LLM + Whisper STT) ───────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# ── Google Gemini (Backup LLM) ──────────────────
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY_2=AIzaSy_yyyyyyyyyyyyyyyyyyyy

# ── Cloudflare Workers AI (Backup) ──────────────
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxx

# ── Bhashini (Translation — register at bhashini.gov.in) ──
BHASHINI_USER_ID=xxxxxxxxxxxxxxxxxxxx
BHASHINI_ULCA_API_KEY=xxxxxxxxxxxxxxxxxxxx

# ── Brevo SMTP (Email Alerts, 300/day free) ──────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your@email.com
BREVO_SMTP_KEY=xsmtp-xxxxxxxxxxxxxxxxxxxx

# ── Telegram Bot ─────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Web Push VAPID ───────────────────────────────
# Generate with: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key, v.private_key)"
VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxx
VAPID_SUBJECT=mailto:admin@jaldrishti.local

# ── NASA Earthdata (GPM IMERG download) ──────────
EARTHDATA_USERNAME=xxxxxxxxxxxxxxxxxxxx
EARTHDATA_PASSWORD=xxxxxxxxxxxxxxxxxxxx

# ── App Config ────────────────────────────────────
APP_ENV=development          # development | production
SECRET_KEY=change-this-to-a-random-64-char-string
PILOT_BBOX=18.48,73.78,18.60,73.92   # Baner-Aundh bbox (lat_min,lon_min,lat_max,lon_max)

# ── Rate Limits ───────────────────────────────────
REPORTS_PER_HOUR_PER_DEVICE=5
REPORTS_PER_DAY_PER_ACCOUNT=20
ALERTS_PER_DAY_PER_USER=3

# ── Cache (disk-based, no Redis) ─────────────────
CACHE_DIR=./cache              # diskcache directory
FORECAST_CACHE_TTL_MIN=90      # minutes before forecast is considered stale
